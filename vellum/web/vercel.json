{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://vellum-app.fly.dev/api/:path*" },
    { "source": "/x402/:path*", "destination": "https://vellum-app.fly.dev/x402/:path*" },
    { "source": "/health", "destination": "https://vellum-app.fly.dev/health" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }] }
  ]
}
