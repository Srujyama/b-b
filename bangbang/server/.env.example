PORT=8787
# Durable state (cases, XRPL escrow release keys [0600], BNB log bodies) as JSON files.
# Relative paths resolve against bangbang/server. Default: bangbang/server/.data (gitignored). Files are 0600.
# ONE server per DATA_DIR: the first write takes DATA_DIR/.lock; a second live process writing there fails loudly.
DATA_DIR=
# Public URL of this server (ngrok etc.) — ElevenLabs server tools call back here
PUBLIC_URL=

# LLMs
# Claude: every LLM call (src/llm.ts: bill reading, Chinese, translation, appeals; the phone agent; research)
ANTHROPIC_API_KEY=
# optional override of the shared model (default claude-opus-5-5), e.g. claude-haiku-5-5 for cheaper/faster
ANTHROPIC_MODEL=

# Voice
ELEVENLABS_API_KEY=
# created by `npm run setup:agents` (scripts/setup-elevenlabs.ts)
ELEVENLABS_ADVOCATE_AGENT_ID=
ELEVENLABS_HOSPITAL_AGENT_ID=
ELEVENLABS_INTAKE_AGENT_ID=

# Research
CONTEXT_DEV_API_KEY=

# XRPL (devnet). Leave seeds blank and run `npm run setup:xrpl` to faucet-fund + write them.
XRPL_NETWORK=wss://s.devnet.rippletest.net:51233
XRPL_FUND_ISSUER_SEED=
XRPL_PATIENT_SEED=
XRPL_HOSPITAL_SEED=
XRPL_CLINIC_SEED=
XRPL_ADVOCATE_SEED=
XRPL_VAULT_ID=
XRPL_LOAN_BROKER_ID=
XRPL_ADVOCATE_FEE_PCT=1
XRPL_ESCROW_CANCEL_DAYS=14

# BNB Chain (BSC testnet, chainId 97) — fund from https://www.bnbchain.org/en/testnet-faucet
BSC_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
BSC_PRIVATE_KEY=
ADVOCATE_LEDGER_ADDRESS=

# AUSD on Base Sepolia (chainId 84532)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
AUSD_ADDRESS=0xa9012a055bd4e0eDfF8Ce09f960291C09D5322dC
# the agent's wallet that PAYS for x402 calls (needs AUSD from faucet; no gas needed)
AGENT_EVM_PRIVATE_KEY=
# the server wallet that RECEIVES x402 payments and submits transferWithAuthorization (needs Base Sepolia ETH)
PAYEE_EVM_PRIVATE_KEY=

# Gemini prediction markets (public data needs no key; sandbox trading does)
GEMINI_API_KEY=
GEMINI_API_SECRET=

# optional: patient signs the BNB mandate herself (EIP-712, no gas needed)
PATIENT_EVM_PRIVATE_KEY=

# ElevenLabs optional tuning
ELEVENLABS_TOOL_MODE=client   # client (no public URL needed) | webhook (needs PUBLIC_URL)
ELEVENLABS_TOOL_SECRET=
ELEVENLABS_INSURER_AGENT_ID=
ELEVENLABS_INTAKE_VOICE_ID=   # pick a native Mandarin voice from the ElevenLabs voice library
ELEVENLABS_ADVOCATE_VOICE_ID=
ELEVENLABS_HOSPITAL_VOICE_ID=

# Outbound phone agent (stream A): the full list with comments is in src/agent/voice.env.example
VOICE_CALLS_ENABLED=false
VOICE_ALLOWED_NUMBERS=   # REQUIRED for live calls (E.164, comma-separated). Empty = never dials
