# Append these settings to bangbang/server/.env. Never commit real keys.
# Branch A keeps this separate because D owns the shared .env.example.
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
VOICE_LLM_MODEL=claude-haiku-5-5
PUBLIC_URL=

# Generate TWO DIFFERENT random tokens, e.g. openssl rand -hex 32 for each.
# Orchestrator sends its token as Authorization: Bearer ...
VOICE_ORCHESTRATOR_TOKEN=
# ElevenLabs Custom LLM uses this token; Anthropic key stays on our server.
VOICE_LLM_TOKEN=

# Filled by npm run setup:agents -- --outbound (save both printed IDs).
ELEVENLABS_LLM_SECRET_ID=
ELEVENLABS_OUTBOUND_AGENT_ID=
# ID of the Twilio number imported into ElevenLabs, NOT the E.164 number or Twilio SID.
ELEVENLABS_PHONE_NUMBER_ID=
# Optional voice override; otherwise the existing advocate voice is used.
ELEVENLABS_ADVOCATE_VOICE_ID=

# Persistent absolute directory OUTSIDE the repo and public web root. Single server instance.
VOICE_JOB_DIR=
# Paste HMAC secret from ElevenLabs workspace webhook settings; enable retries.
ELEVENLABS_WEBHOOK_SECRET=
# Optional webhook ID; setup attaches it to the outbound agent when present.
ELEVENLABS_POST_CALL_WEBHOOK_ID=

# Enable only after agent, phone number, endpoint and tokens are configured.
VOICE_CALLS_ENABLED=false
# REQUIRED for live calls: comma-separated destination allowlist (E.164). Empty = no calls are placed.
VOICE_ALLOWED_NUMBERS=
